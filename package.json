{
  "name": "hexlet_qa_market",
  "version": "0.1.0",
  "description": "Hexlet QA market",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^8.3.0",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "fastify": "^5.8.5",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.1.0",
    "i18next": "^26.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "fastify start -w -l info -P -p 3001 server/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "fastify start -l info -a 0.0.0.0 -p ${PORT:-8080} server/app.js",
    "test": "vitest run",
    "lint": "oxlint --config=.oxlintrc.json .",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore . && oxlint --config=.oxlintrc.json --fix .",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check ."
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "i18next-cli": "^1.69.2",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^22.2.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.20.0"
}
