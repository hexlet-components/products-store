{
  "name": "hexlet_qa_market",
  "version": "0.1.0",
  "description": "Hexlet QA market",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.7",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fastify": "^5.12.7",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.1",
    "i18next": "^26.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.4",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "fastify start -w -l info -P -p 3001 server/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "fastify start -l info -a 0.0.0.0 -p ${PORT:-8080} server/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "i18next-cli": "^1.80.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.6.0"
}
