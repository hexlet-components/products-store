{
  "name": "hexlet_qa_market",
  "version": "0.1.0",
  "description": "Hexlet QA market",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "bootstrap": "^5.3.8",
    "fastify": "^5.8.5",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0",
    "i18next": "^26.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.16.0",
    "redux-saga": "^1.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "fastify start -w -l info -P -p 3001 server/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "fastify start -l info -a 0.0.0.0 -p ${PORT:-8080} server/app.js",
    "test": "vitest run",
    "lint": "oxlint --config=.oxlintrc.json .",
    "lint-fix": "biome check --write .",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore . && oxlint --config=.oxlintrc.json --fix .",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check ."
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "npm-check-updates": "^23.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.20.0"
}
