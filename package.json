{
  "name": "hexlet_qa_market",
  "version": "0.1.0",
  "description": "Hexlet QA market",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fastify": "^5.12.1",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "fastify start -w -l info -P -p 3001 server/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "fastify start -l info -a 0.0.0.0 -p ${PORT:-8080} server/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config=.oxlintrc.json .",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore . && oxlint --config=.oxlintrc.json --fix .",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check ."
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "i18next-cli": "^1.71.3",
    "jsdom": "^30.0.1",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
