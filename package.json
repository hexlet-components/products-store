{
  "name": "hexlet_qa_market",
  "version": "0.1.0",
  "description": "Hexlet QA market",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/static": "^10.1.5",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fastify": "^5.12.5",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^6.0.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "fastify start -w -l info -P -p 3001 server/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "fastify start -l info -a 0.0.0.0 -p ${PORT:-8080} server/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "i18next-cli": "^1.74.1",
    "jsdom": "^30.1.1",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
